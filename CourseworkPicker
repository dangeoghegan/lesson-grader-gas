<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 20px;
      background: #f8fafc;
      color: #1e293b;
    }
    h2 { margin-top: 0; font-size: 18px; color: #0f172a; }
    .form-group { margin-bottom: 16px; }
    label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px; }
    select, input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #fff;
      font-size: 14px;
      box-sizing: border-box;
    }
    .info-box {
      background: #e2e8f0;
      padding: 12px;
      border-radius: 6px;
      font-size: 13px;
      margin-top: 12px;
      display: none;
    }
    .btn-group {
      margin-top: 24px;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
    button {
      padding: 9px 18px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      border: none;
    }
    .btn-primary { background: #2563eb; color: #fff; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-secondary { background: #e2e8f0; color: #334155; }
    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid #cbd5e1;
      border-top-color: #2563eb;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .status-msg { margin-top: 12px; font-size: 13px; font-weight: 500; }
    .success { color: #15803d; }
    .error { color: #b91c1c; }
  </style>
</head>
<body>
  <h2>Select Google Classroom Assignment</h2>
  <div class="form-group">
    <label for="courseSelect">1. Select Classroom Course:</label>
    <select id="courseSelect" onchange="onCourseChanged()">
      <option value="">-- Loading courses... --</option>
    </select>
  </div>

  <div class="form-group">
    <label for="assignmentSelect">2. Select Assignment / Coursework:</label>
    <select id="assignmentSelect" onchange="onAssignmentChanged()" disabled>
      <option value="">-- Select a course first --</option>
    </select>
  </div>

  <div id="assignmentInfo" class="info-box">
    <div><b>Max Marks:</b> <span id="infoMaxPoints">-</span></div>
    <div><b>Due Date:</b> <span id="infoDueDate">-</span></div>
    <div><b>State:</b> <span id="infoState">-</span></div>
  </div>

  <div id="statusMsg" class="status-msg"></div>

  <div class="btn-group">
    <button class="btn-secondary" onclick="google.script.host.close()">Cancel</button>
    <button id="saveBtn" class="btn-primary" onclick="saveSelection()" disabled>Save & Set Active</button>
  </div>

  <script>
    var coursesMap = {};
    var assignmentsMap = {};

    window.onload = function() {
      loadCourses();
    };

    function loadCourses() {
      showStatus('<span class="spinner"></span> Loading your Google Classroom courses...', '');
      google.script.run
        .withSuccessHandler(function(res) {
          if (!res.success) {
            showStatus(res.message, 'error');
            return;
          }
          var select = document.getElementById('courseSelect');
          select.innerHTML = '<option value="">-- Choose a course --</option>';
          var courses = res.courses || [];
          if (!courses.length) {
            select.innerHTML = '<option value="">-- No active courses found --</option>';
            showStatus('No active Classroom courses found for your account.', 'error');
            return;
          }
          courses.forEach(function(c) {
            coursesMap[c.id] = c;
            var opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.name + (c.section ? ' (' + c.section + ')' : '');
            select.appendChild(opt);
          });
          showStatus('', '');
        })
        .withFailureHandler(function(err) {
          showStatus('Error loading courses: ' + err.message, 'error');
        })
        .apiListTeacherCourses();
    }

    function onCourseChanged() {
      var courseId = document.getElementById('courseSelect').value;
      var aSelect = document.getElementById('assignmentSelect');
      var saveBtn = document.getElementById('saveBtn');
      var infoBox = document.getElementById('assignmentInfo');
      infoBox.style.display = 'none';
      saveBtn.disabled = true;

      if (!courseId) {
        aSelect.innerHTML = '<option value="">-- Select a course first --</option>';
        aSelect.disabled = true;
        return;
      }

      aSelect.disabled = true;
      aSelect.innerHTML = '<option value="">-- Loading assignments... --</option>';
      showStatus('<span class="spinner"></span> Loading coursework assignments...', '');

      google.script.run
        .withSuccessHandler(function(res) {
          if (!res.success) {
            showStatus(res.message, 'error');
            return;
          }
          var cwList = res.coursework || [];
          aSelect.innerHTML = '<option value="">-- Choose an assignment --</option>';
          assignmentsMap = {};
          if (!cwList.length) {
            aSelect.innerHTML = '<option value="">-- No published assignments found --</option>';
            showStatus('No published assignments found in this course.', 'error');
            return;
          }
          cwList.forEach(function(cw) {
            assignmentsMap[cw.id] = cw;
            var opt = document.createElement('option');
            opt.value = cw.id;
            opt.textContent = cw.title + ' (Max: ' + cw.maxPoints + ' pts)';
            aSelect.appendChild(opt);
          });
          aSelect.disabled = false;
          showStatus('', '');
        })
        .withFailureHandler(function(err) {
          showStatus('Error loading coursework: ' + err.message, 'error');
        })
        .apiListCourseWork(courseId);
    }

    function onAssignmentChanged() {
      var cwId = document.getElementById('assignmentSelect').value;
      var saveBtn = document.getElementById('saveBtn');
      var infoBox = document.getElementById('assignmentInfo');

      if (!cwId || !assignmentsMap[cwId]) {
        infoBox.style.display = 'none';
        saveBtn.disabled = true;
        return;
      }

      var cw = assignmentsMap[cwId];
      document.getElementById('infoMaxPoints').textContent = cw.maxPoints + ' points';
      document.getElementById('infoDueDate').textContent = cw.dueDate || 'No due date set';
      document.getElementById('infoState').textContent = cw.state || 'PUBLISHED';
      infoBox.style.display = 'block';
      saveBtn.disabled = false;
    }

    function saveSelection() {
      var courseId = document.getElementById('courseSelect').value;
      var cwId = document.getElementById('assignmentSelect').value;
      if (!courseId || !cwId) return;

      var saveBtn = document.getElementById('saveBtn');
      saveBtn.disabled = true;
      showStatus('<span class="spinner"></span> Saving Classroom configuration...', '');

      google.script.run
        .withSuccessHandler(function(res) {
          if (res.success) {
            showStatus('Configuration saved! You can now import submissions.', 'success');
            setTimeout(function() {
              google.script.host.close();
            }, 1200);
          } else {
            showStatus('Save failed: ' + res.message, 'error');
            saveBtn.disabled = false;
          }
        })
        .withFailureHandler(function(err) {
          showStatus('Error saving selection: ' + err.message, 'error');
          saveBtn.disabled = false;
        })
        .apiSaveClassroomSelection(courseId, cwId);
    }

    function showStatus(html, type) {
      var el = document.getElementById('statusMsg');
      el.className = 'status-msg ' + type;
      el.innerHTML = html;
    }
  </script>
</body>
</html>
